@startuml comunicacao

skinparam monochrome true
skinparam backgroundColor white
skinparam objectBackgroundColor white
skinparam objectBorderColor black
skinparam legendBackgroundColor white
skinparam legendBorderColor black
hide empty members
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam titleFontSize 18
skinparam nodesep 30
skinparam ranksep 64
skinparam linetype polyline

title Comunicação - AgendarConsulta

object ":AgendamentoController" as C
object ":ServicoAutenticacao" as Auth
object ":AgendarConsulta" as UC
object ":Slot" as Horario
object ":UnidadeDeTrabalho" as UoW
object "Repositórios\n(portas)" as Repos
object ":AgendaProfissional" as AP
object ":AgendaPaciente" as AC
object ":Consulta" as Cons
object ":Paciente" as P

P -right- C : → 1: POST /consultas\n← 1.3: HTTP 201
C -right-> Auth : 1.1 [se aplicável]:\ncontexto :=\nidentificarUsuario()
C -down-> UC : 1.2: consulta :=\nexecutar(dados)

UC -left-> Horario : 1.2.3: válido := validarGrade()
UC -right-> UoW : 1.2.1: iniciar()\n1.2.9: commit()
' O participante Repositórios agrupa portas distintas para compactar o desenho.
UC -down-> Repos : 1.2.2: dados :=\ncarregar dados\n1.2.7: salvar(consulta)\n1.2.8: registrar(PENDENTE)
UC -down-> AP : 1.2.4: disponível :=\nestaDisponivel(slot)
UC -down-> AC : 1.2.5: apto := podeAgendar(slot,\nespecialidade_id)
UC -down-> Cons : 1.2.6: «create»\nAGENDADA

' As ligações ocultas alinham os participantes abaixo do caso de uso.
AP -[hidden]right-> AC
AC -[hidden]right-> Cons
Cons -[hidden]right-> Repos

legend bottom
  Paciente identificado e autorizado. Identificação a definir.
  Cenário de sucesso. O retorno de executar ocorre após o commit.
  ConsultaRepositorio e NotificacaoPendenteRepositorio gravam
  na mesma transação. O envio ocorre posteriormente.
endlegend

@enduml
