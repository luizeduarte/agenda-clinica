@startuml sequencia

autonumber
hide footbox
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam maxMessageSize 85

actor "Paciente" as P
boundary "AgendamentoController" as C
participant "Autenticacao\n(contrato)" as AUTH_C
participant "ServicoAutenticacao" as AUTH
control "AgendarConsulta" as UC
participant "Slot" as SLOT
participant "ConsultaRepositorio" as CREP
participant "Cadastros\n(contrato)" as CAD
participant "Agenda\n(contrato)" as AG_C
participant "Consultas\n(contrato)" as CONS_C
participant "AgendaRepositorio" as AGREP
participant "AgendaProfissional" as AP
participant "AgendaPaciente" as APA
participant "Notificacoes\n(contrato)" as NOT_C
participant "NotificacaoPendenteRepositorio" as NREP
database "SQLite" as DB

P -> C : POST /consultas (profissional_id, inicio)\nAuthorization: Bearer <token>
C -> AUTH_C : identificar_por_cabecalho(authorization)
break Cabeçalho ausente ou malformado
  AUTH_C --> C : NaoAutenticadoError
  C --> P : 401 Unauthorized
end
AUTH_C -> AUTH : identificar(token)
break Credencial inválida
  AUTH --> AUTH_C : NaoAutenticadoError
  AUTH_C --> C : NaoAutenticadoError
  C --> P : 401 Unauthorized
end
AUTH --> AUTH_C : usuario
AUTH_C --> C : usuario
note over AUTH
  No protótipo, ServicoAutenticacaoFake.
end note
note over C
  Agendar requer autorização pelo papel (RNF03).
end note
C -> UC : executar(comando)
alt Papel sem permissão
  UC --> C : NaoAutorizadoError
  C --> P : 403 Forbidden
else Paciente identificado e autorizado
  UC -> SLOT : a_partir_de(inicio)

  alt Dados ou slot invalidos
    SLOT --> UC : SlotInvalidoError
    UC --> C : erro de validacao
    C --> P : 400 Bad Request
  else Slot valido
    SLOT --> UC : slot
    UC -> SLOT : esta_no_futuro(agora)
    break Horário já iniciado
      SLOT --> UC : false
      UC --> C : SlotInvalidoError
      C --> P : 400 Bad Request
    end
    SLOT --> UC : true
    UC -> CREP : transacao()
    CREP -> DB : BEGIN IMMEDIATE
    note over UC, SLOT : O relógio é lido novamente após adquirir o bloqueio.
    UC -> SLOT : esta_no_futuro(agora)
    break Horário iniciado durante a espera pelo bloqueio
      SLOT --> UC : false
      CREP -> DB : ROLLBACK
      UC --> C : SlotInvalidoError
      C --> P : 400 Bad Request
    end
    SLOT --> UC : true
    UC -> CAD : obter_paciente(paciente_id)\ne obter_profissional(profissional_id)
    CAD --> UC : paciente, profissional
    UC -> AG_C : verificar_disponibilidade(profissional_id, slot)
    AG_C -> CONS_C : listar_slots_ocupados_profissional(profissional_id, inicio, fim)
    CONS_C -> CREP : listar_consultas_ativas_profissional(...)
    CREP --> CONS_C : consultas ativas
    CONS_C --> AG_C : slots ocupados
    AG_C -> AGREP : obter_horarios_atendimento(profissional_id)\ne listar_bloqueios(profissional_id, inicio, fim)
    AGREP --> AG_C : horarios e bloqueios

    note over AP : AgendaProfissional montada com os dados carregados.
    AG_C -> AP : verificar_disponivel(slot)
    break Horário ocupado, bloqueado ou fora do atendimento
      AP --> AG_C : HorarioIndisponivelError
      AG_C --> UC : HorarioIndisponivelError
      CREP -> DB : ROLLBACK
      UC --> C : conflito de agendamento
      C --> P : 409 Conflict
    end
    AP --> AG_C : sem valor de retorno
    AG_C --> UC : sem valor de retorno
    UC -> CREP : listar_consultas_ativas_paciente(paciente_id)
    CREP --> UC : consultas ativas do paciente
    note over APA : AgendaPaciente montada com os dados carregados.
    UC -> APA : verificar_pode_agendar(slot, especialidade_id, agora)

    alt Conflito ou limite do paciente excedido
      APA --> UC : ConflitoDoPacienteError / LimiteDoPacienteExcedidoError
      CREP -> DB : ROLLBACK
      UC --> C : conflito de agendamento
      C --> P : 409 Conflict
    else Horario disponivel
      APA --> UC : sem valor de retorno
      create participant "consulta: Consulta" as CONS
      UC -> CONS : «create» AGENDADA
      alt Duas gravações e commit bem-sucedidos
        UC -> CREP : adicionar(consulta)
        CREP -> DB : INSERT consulta
        UC -> NOT_C : registrar_agendamento(...)
        NOT_C -> NREP : adicionar(pendente)
        NREP -> DB : INSERT notificacao_pendente
        CREP -> DB : COMMIT
        UC --> C : consulta registrada
        C --> P : 201 Created
      else Falha na gravação ou no commit
        note over UC, DB : A primeira falha interrompe as operações restantes.
        opt Transação ainda aberta
          CREP -> DB : ROLLBACK
        end

        alt Violação da restrição de unicidade da reserva
          UC --> C : conflito de agendamento
          C --> P : 409 Conflict
        else Falha interna inesperada
          UC --> C : erro interno
          C --> P : 500 Internal Server Error
        end
      end
    end
  end
end

== Processamento posterior (fora da requisicao HTTP) ==
participant "ProcessadorDeNotificacoes" as PROC
participant "Notificador" as NOTIF
participant "pendente: NotificacaoPendente" as PEND
PROC -> NREP : listar_para_envio()
NREP --> PROC : notificacoes pendentes
loop Para cada pendencia
  PROC -> NOTIF : enviar(notificacao)
  alt Envio bem-sucedido
    NOTIF --> PROC : sucesso
    PROC -> PEND : marcar_enviada()
    PROC -> NREP : atualizar(pendente)
  else Falha no canal externo
    NOTIF --> PROC : falha
    PROC -> PEND : registrar_falha(erro)
    PROC -> NREP : atualizar(pendente)
  end
end

note over CREP, DB
  Os casos de uso chamam portas abstratas e contratos entre módulos.
  Os adaptadores SQLite concretos executam o SQL.
  ConexaoSQLite gerencia a conexão e a transação por thread
  compartilhadas pelos repositórios.
end note
note right of NOTIF
  No prototipo, NotificadorFake.
end note
@enduml
